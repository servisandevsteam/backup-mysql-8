{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "shuck": {
      "command": ["shuck", "server"],
      "extensions": [".sh", ".bash", ".zsh", ".ksh"]
    }
  },
  "formatter": {
    "shellharden": {
      "command": ["shellharden", "--replace", "$FILE"],
      "extensions": [".sh", ".bash"]
    }
  }
}
